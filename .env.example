APP_NAME=vnstock-agent
DEBUG=false
LOG_LEVEL=INFO
LOGGER_TYPE=logxide
PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gpt-oss:120b-cloud
MARKET_DATA_PROVIDER=vnstock
VNSTOCK_SOURCE=VCI
VNSTOCK_HISTORY_WINDOW_DAYS=30

# Bounded thread pool for blocking sync tool I/O offloaded by Pydantic AI
THREAD_POOL_MAX_WORKERS=16

# Per-run usage limits forwarded to AGUIAdapter at request time.
# TOTAL_TOKENS_LIMIT is a run-wide budget (cumulative input+output tokens
# across all model calls in a single run); size against Ollama num_ctx.
USAGE_REQUEST_LIMIT=5
USAGE_TOOL_CALLS_LIMIT=8
USAGE_TOTAL_TOKENS_LIMIT=20000
